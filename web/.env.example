# Backend origin used by the browser. Leave EMPTY in development: the Vite
# dev server proxies /api and /socket.io to VITE_DEV_BACKEND_URL, so the
# dashboard is same-origin and needs no CORS setup.
# For a production build served from another host, set the backend origin,
# e.g. https://smartlens-api.example.com (and add the dashboard origin to the
# backend's CORS_ORIGINS).
VITE_API_BASE_URL=

# Where the Vite dev/preview proxy forwards /api and /socket.io.
VITE_DEV_BACKEND_URL=http://localhost:3000

# REST polling interval used when the WebSocket connection is unavailable (ms).
VITE_POLL_INTERVAL_MS=5000

# Note: no API keys belong here. Everything in VITE_* is visible to browsers.
