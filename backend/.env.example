# ---------------------------------------------------------------------------
# SmartLens backend configuration. Copy to `.env` and adjust.
# Never commit a real `.env` file (it is git-ignored).
# ---------------------------------------------------------------------------

# Interface and port. 0.0.0.0 accepts connections from your local network so a
# phone on the same Wi-Fi can connect. Use 127.0.0.1 to allow this computer only.
# Do NOT port-forward this server to the public internet.
HOST=0.0.0.0
PORT=3000

# MongoDB connection string. Leave empty (or stop MongoDB) in demo mode to use
# TEMPORARY in-memory storage. Required when DEMO_MODE=false.
MONGODB_URI=mongodb://127.0.0.1:27017/smartlens

# Server-side Google Places API (New) key. Leave empty to use free, real
# OpenStreetMap places instead. This key must never be placed in the Android
# app or the web app.
GOOGLE_PLACES_API_KEY=

# Where nearby places come from:
#   auto   = Google when GOOGLE_PLACES_API_KEY is set, otherwise OpenStreetMap
#   google = Google only (503 without a key)
#   osm    = OpenStreetMap via the public Overpass API (free, no key)
#   demo   = fictional, clearly labelled demo places (no network)
#   none   = nearby search disabled
PLACES_PROVIDER=auto
# Optional comma-separated Overpass server(s), tried in order.
# Default: maps.mail.ru, overpass-api.de, lz4.overpass-api.de. The next server
# is also asked when one fails or is slow; the first answer wins.
OVERPASS_URL=
# Public Overpass servers are shared and can take 30 s or more when busy.
OSM_TIMEOUT_MS=45000

# Comma-separated list of web origins allowed to call the API.
# Empty = local Vite dev/preview origins (http://localhost:5173, :4173).
CORS_ORIGINS=

# true  = simulated places when no API key, in-memory fallback when MongoDB is
#         unavailable, and the dashboard demo simulator is enabled.
# false = MongoDB and a Places API key are required.
DEMO_MODE=true

# How often the phone sends location while a session is active (seconds).
LOCATION_UPDATE_INTERVAL_SECONDS=5

# Optional tuning -----------------------------------------------------------
# A session with no updates for this long is marked inactive ("timeout").
SESSION_TIMEOUT_SECONDS=120
# Location history older than this is deleted automatically (MongoDB TTL index).
LOCATION_RETENTION_HOURS=24
# In-memory cache for identical Places API requests (0 disables caching).
PLACES_CACHE_TTL_SECONDS=300
PLACES_TIMEOUT_MS=8000

# Optional shared key required by the web dashboard (X-Dashboard-Key header /
# Socket.IO auth). Empty = dashboard is open to anyone who can reach the server.
DASHBOARD_ACCESS_KEY=

# Centre of the fictional route used by the dashboard demo simulator.
DEMO_CENTER_LAT=12.8230
DEMO_CENTER_LNG=80.0444

# debug | info | warn | error | silent
LOG_LEVEL=info
